; メロスゲーム  --  asymmetric co-op 2D action
; Engine configuration file.

config_version=5

[application]

config/name="Melos Game"
; One version number, read by tools/release-check.sh and compared against
; the export presets and both workflows. They drifted apart once (iOS was
; shipping 0.2.3 while Play built 0.2.4) and nothing noticed.
config/version="0.9.0"
config/description="Asymmetric co-op 2D action. One player runs, one player rewrites the world."
run/main_scene="res://src/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
; The engine's own first frame is painted in the start screen's sky colour
; instead of black; src/boot.tscn takes over as soon as scripts can run.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.9, 0.97, 1, 1)

[autoload]

Balance="*res://src/autoload/balance.gd"
Clock="*res://src/autoload/clock.gd"
Audio="*res://src/autoload/audio.gd"
Events="*res://src/autoload/events.gd"
GameState="*res://src/autoload/game_state.gd"
Entitlement="*res://src/autoload/entitlement.gd"
EntitlementClient="*res://src/store/entitlement_client.gd"
Iap="*res://src/store/iap.gd"
EosRuntime="*res://src/net/eos/eos_runtime.gd"

; These files are installed from the pinned EOSG release before CI imports the
; project. Keeping the autoloads explicit makes exported builds independent of
; whether an editor happened to enable the plugin first.
EOSGRuntime="*res://addons/epic-online-services-godot/runtime.gd"
HPlatform="*res://addons/epic-online-services-godot/heos/hplatform.gd"
HAuth="*res://addons/epic-online-services-godot/heos/hauth.gd"
HLobbies="*res://addons/epic-online-services-godot/heos/hlobbies.gd"
HP2P="*res://addons/epic-online-services-godot/heos/hp2p.gd"

[internationalization]

locale/translations=PackedStringArray("res://translations/en.po")

[editor_plugins]

enabled=PackedStringArray("res://addons/epic-online-services-godot/plugin.cfg")

[debug]

; The app kept no log on the device, which is why a freeze on a phone came
; back as a bug report with nothing in it: the kernel's ring buffer had been
; overwritten and Godot had written nothing of its own. Godot's own default
; only logs on desktop (the `.pc` override), so the base key is set here to
; get a log on Android too.
;
; It lands in Android/data/<package>/files/logs/ on the device, five files
; deep, which is enough to survive a couple of restarts without growing
; without limit.
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

