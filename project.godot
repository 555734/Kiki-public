[input_devices]

; Buttons and text fields are Control nodes, and a Control never sees a touch --
; it sees the mouse event Godot emulates from one. With this off, every button
; on the connect screen was dead on a phone.
;
; It is safe to turn on: InputHub handles only InputEventScreenTouch and
; InputEventScreenDrag, and its desktop polling stops the moment a touch
; arrives, so the emulated mouse events reach the UI and nothing else.
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[layer_names]

2d_physics/layer_1="terrain"
2d_physics/layer_2="runner"
2d_physics/layer_3="enemy"
2d_physics/layer_4="hologram"
2d_physics/layer_5="projectile"
2d_physics/layer_6="hazard"
2d_physics/layer_7="shootable"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

; Required for an Android export with the mobile renderer. Godot refuses the
; export unless the project can produce ETC2/ASTC textures, and it reports that
; as a *blank* configuration error, so it is worth a note. Comments in this file
; must start with ';' -- a '#' line silently swallows the key that follows it.
textures/vram_compression/import_etc2_astc=true
; Astra's complete 3D world uses the mobile renderer. The Android workflow
; also emits a compatibility build, but Motorola/PowerVR devices must use the
; explicitly named Vulkan artifact to avoid the GLES3 mesh driver crash.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=1
; ...but not on a phone, where the pixels are small enough that the
; smoothing is hard to see and the extra resolve is not.
anti_aliasing/quality/msaa_2d.mobile=0

