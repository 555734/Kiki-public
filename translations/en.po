msgid "メロスゲーム"
msgstr "Melos Game"

msgid "メロスゲーム   ✦"
msgstr "Melos Game   ✦"

msgid "読み込み中"
msgstr "Loading"

msgid "走る・跳ぶ・助け合う最初の一歩"
msgstr "Run, jump, and help each other"

