msgstr "Only chasing enemies change speed"

msgid "イージー"
msgstr "Easy"

msgid "ノーマル"
msgstr "Normal"

msgid "ハード"
msgstr "Hard"

msgid "—  遊び方を選択  —"
msgstr "—  CHOOSE HOW TO PLAY  —"

msgid "一緒に遊ぶ方法を選んでください"
msgstr "Choose how to play together"

msgid "この1台で一緒に遊ぶ"
msgstr "Play together on one device"

msgid "▶  この1台で 2人プレイを始める"
msgstr "▶  Start two-player game here"

msgid "オンラインで離れて遊ぶ"
