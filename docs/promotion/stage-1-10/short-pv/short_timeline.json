  {
   "at": 0.2,
   "len": 2.21,
   "text": "落ちていく相棒を、指一本で救う。"
  },
  {
   "at": 2.7,
   "len": 2.13,
   "text": "これは、ふたりで遊ぶ協力アクション。"
  },
  {
   "at": 5.0,
   "len": 1.46,
   "text": "ひとりは走って、跳ぶ。"
  },
  {
   "at": 6.65,
   "len": 1.85,
   "text": "でも、届かないと谷底へ。"
  },
  {
   "at": 8.52,
   "len": 1.08,
   "text": "そこで相棒を呼ぶと、"
  },
  {
   "at": 9.52,
   "len": 1.07,
   "text": "指で足場を描いて、"
  },
  {
   "at": 10.45,
   "len": 0.8,
   "text": "受け止めてくれる！"
  },
  {
   "at": 12.35,
   "len": 2.59,
   "text": "嵐、火山、列車、巨人。"
  },
  {
   "at": 15.29,
   "len": 1.96,
   "text": "ステージごとに、助け方が変わる。"
  },
  {
   "at": 17.69,
   "len": 2.5,
   "text": "離れた友達とも、合言葉ひとつで遊べる。"
  },
  {
