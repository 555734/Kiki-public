 "narration": [
  {
   "at": 0.15,
   "len": 1.13,
   "text": "このゲームの目的は"
  },
  {
   "at": 1.341,
   "len": 1.78,
   "text": "走って跳ぶことしかできない相棒を"
  },
  {
   "at": 3.182,
   "len": 1.35,
   "text": "ゴールまで送り届けること"
  },
  {
   "at": 4.787,
   "len": 0.83,
   "text": "しかし相棒は"
  },
  {
   "at": 5.679,
   "len": 1.16,
   "text": "無茶なジャンプをするので"
  },
  {
   "at": 6.987,
   "len": 1.22,
   "text": "普通に谷へ落ちていく"
  },
  {
   "at": 8.337,
   "len": 0.99,
   "text": "そこで通話である"
  },
  {
   "at": 9.437,
   "len": 1.15,
   "text": "急いで足場を描く"
  },
  {
   "at": 11.037,
   "len": 1.49,
   "text": "相棒はなんとか向こう岸へ"
  },
  {
   "at": 12.987,
   "len": 1.19,
   "text": "その後も雷が落ち"
  },
  {
   "at": 14.241,
   "len": 0.74,
   "text": "岩が転がり"
  },
  {
   "at": 15.037,
   "len": 0.97,
   "text": "巨人が暴れるが"
  },
  {
   "at": 16.258,
   "len": 1.62,
   "text": "とにかく全力で足場を描き"
  },
  {
   "at": 17.939,
   "len": 1.42,
   "text": "相棒をゴールまで運ぶのだ"
  },
  {
   "at": 19.758,
   "len": 0.52,
   "text": "ちなみに"
  },
  {
   "at": 20.341,
   "len": 1.02,
   "text": "このゲームの名前は"
  },
  {
