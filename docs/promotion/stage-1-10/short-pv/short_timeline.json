 "narration": [
  {
   "at": 0.2,
   "len": 1.65,
   "text": "ふたりで遊ぶアクションゲームです。"
  },
  {
   "at": 2.2,
   "len": 3.47,
   "text": "ひとりが走って、もうひとりが、画面に足場を描きます。"
  },
  {
   "at": 6.2,
   "len": 1.15,
   "text": "ジャンプが届かないと、"
  },
  {
   "at": 7.45,
   "len": 1.31,
   "text": "谷に落ちてしまいますが、"
  },
  {
   "at": 8.8,
   "len": 1.01,
   "text": "通話で呼ばれたら、"
  },
  {
   "at": 9.85,
   "len": 0.97,
   "text": "足場を描いて、"
  },
  {
   "at": 10.88,
   "len": 0.73,
   "text": "受け止めます。"
  },
  {
   "at": 11.7,
   "len": 1.57,
   "text": "そのまま、向こう岸へ。"
  },
  {
   "at": 13.45,
   "len": 2.97,
   "text": "嵐、火山、列車、巨人など、"
  },
  {
   "at": 16.72,
   "len": 1.38,
   "text": "ステージはいろいろあります。"
  },
  {
   "at": 18.74,
   "len": 3.08,
   "text": "離れた友達とは、6文字の合言葉でつながります。"
  },
  {
   "at": 22.48,
   "len": 1.13,
   "text": "このゲームの名前は、"
  },
  {
   "at": 23.86,
   "len": 0.77,
   "text": "メロスゲーム。"
  }
